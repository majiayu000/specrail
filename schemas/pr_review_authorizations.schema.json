{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specrail.local/schemas/pr_review_authorizations.schema.json",
  "title": "Pull Request Review Authorizations",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "human_authorization": {
      "type": "object",
      "required": ["actor", "source", "head_sha", "authorized_at"],
      "additionalProperties": true,
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "head_sha": {
          "type": "string",
          "minLength": 1
        },
        "authorized_at": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "run_authorization": {
      "type": "object",
      "required": [
        "actor",
        "source",
        "repository",
        "run_id",
        "decision",
        "authorized_at"
      ],
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "const": "authorize_auto_run"
        },
        "authorized_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "self_review_authorization": {
      "type": "object",
      "required": ["actor", "source", "scope"],
      "additionalProperties": true,
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}

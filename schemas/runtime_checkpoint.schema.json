{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specrail.local/schemas/runtime_checkpoint.schema.json",
  "title": "SpecRail milestone checkpoint",
  "description": "A local resume cursor. GitHub and SpecRail artifacts remain the workflow truth.",
  "type": "object",
  "required": [
    "checkpoint_version",
    "run_id",
    "repo",
    "scope",
    "status",
    "milestone",
    "completed",
    "pending",
    "blocked",
    "artifact_refs",
    "resume",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "checkpoint_version": {"const": 4},
    "run_id": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "status": {"enum": ["running", "handoff", "blocked", "complete"]},
    "milestone": {
      "type": "object",
      "required": ["id", "state"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "state": {"enum": ["active", "paused", "complete"]},
        "completed_at": {"type": ["string", "null"]}
      }
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "number"],
        "additionalProperties": false,
        "properties": {
          "kind": {"enum": ["issue", "pr"]},
          "number": {"type": "integer", "minimum": 1}
        }
      }
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "number", "next_action"],
        "additionalProperties": false,
        "properties": {
          "kind": {"enum": ["issue", "pr"]},
          "number": {"type": "integer", "minimum": 1},
          "next_action": {"type": "string", "minLength": 1}
        }
      }
    },
    "blocked": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "number", "reason"],
        "additionalProperties": false,
        "properties": {
          "kind": {"enum": ["issue", "pr"]},
          "number": {"type": "integer", "minimum": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "resume": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  }
}

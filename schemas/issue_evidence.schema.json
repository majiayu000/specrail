{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specrail.local/schemas/issue_evidence.schema.json",
  "title": "SpecRail current GitHub issue evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue",
    "github_state",
    "state",
    "state_source",
    "state_trusted",
    "labels",
    "outcomes",
    "url",
    "title",
    "artifacts"
  ],
  "properties": {
    "issue": {"type": "integer", "minimum": 1},
    "github_state": {"enum": ["OPEN", "CLOSED"]},
    "state": {
      "type": ["string", "null"],
      "enum": [
        "new_issue",
        "needs_info",
        "ready_to_spec",
        "ready_to_implement",
        "in_progress",
        "review",
        "done",
        "parked",
        null
      ]
    },
    "state_source": {"enum": ["label", "body_hint", "none"]},
    "state_trusted": {"type": "boolean"},
    "labels": {"type": "array", "items": {"type": "string"}},
    "outcomes": {
      "type": "array",
      "items": {"enum": ["duplicate", "abandoned", "security_private", "done"]}
    },
    "url": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_spec", "tech_spec", "task_plan"],
      "properties": {
        "product_spec": {"type": "string", "minLength": 1},
        "tech_spec": {"type": "string", "minLength": 1},
        "task_plan": {"type": "string", "minLength": 1}
      }
    },
    "enforcement_sensitive": {"type": "boolean"},
    "sensitive_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "changed_paths",
        "spec_refs",
        "matched_paths",
        "matched_specs",
        "registry_configured",
        "enforcement_sensitive",
        "source_path",
        "planned_paths_complete"
      ],
      "properties": {
        "source": {"const": "tech_spec"},
        "changed_paths": {"type": "array", "items": {"type": "string"}},
        "spec_refs": {"type": "array", "items": {"type": "string"}},
        "matched_paths": {"type": "array", "items": {"type": "string"}},
        "matched_specs": {"type": "array", "items": {"type": "string"}},
        "registry_configured": {"type": "boolean"},
        "enforcement_sensitive": {"type": "boolean"},
        "source_path": {"type": "string", "minLength": 1},
        "planned_paths_complete": {"const": true}
      }
    }
  }
}

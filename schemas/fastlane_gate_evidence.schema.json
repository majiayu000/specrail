{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specrail.local/schemas/fastlane_gate_evidence.schema.json",
  "title": "Fastlane Merge Gate Evidence",
  "type": "object",
  "required": [
    "pr",
    "repository",
    "state",
    "is_draft",
    "head_sha",
    "pr_tier",
    "pr_tier_evidence",
    "enforcement_sensitive",
    "protected_paths",
    "auth_mode",
    "checks_head_sha",
    "checks",
    "focused_tests",
    "independent_review",
    "merge_state",
    "gate_started_at"
  ],
  "additionalProperties": false,
  "properties": {
    "pr": {"type": "integer", "minimum": 1},
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "state": {"const": "OPEN"},
    "is_draft": {"const": false},
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"
    },
    "pr_tier": {"const": "fastlane"},
    "pr_tier_evidence": {
      "type": "object",
      "required": ["changed_lines", "touched_paths"],
      "additionalProperties": false,
      "properties": {
        "changed_lines": {
          "type": "integer",
          "minimum": 0,
          "exclusiveMaximum": 51
        },
        "touched_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "enforcement_sensitive": {"const": false},
    "protected_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "auth_mode": {"enum": ["auto", "review"]},
    "run_id": {"type": "string", "minLength": 1},
    "checks_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "conclusion"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"const": "COMPLETED"},
          "conclusion": {"const": "SUCCESS"}
        }
      }
    },
    "focused_tests": {
      "type": "object",
      "required": ["command", "passed", "head_sha"],
      "additionalProperties": false,
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "passed": {"const": true},
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"
        }
      }
    },
    "independent_review": {
      "type": "object",
      "required": [
        "review_source",
        "review_execution",
        "head_sha",
        "status",
        "verdict",
        "tier_attestation",
        "review_completed_at"
      ],
      "additionalProperties": false,
      "properties": {
        "review_source": {"const": "independent_lane"},
        "review_execution": {"const": "local"},
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"
        },
        "status": {"const": "completed"},
        "verdict": {"enum": ["clean", "non_blocking"]},
        "tier_attestation": {
          "type": "object",
          "required": ["pr_tier", "attested", "basis"],
          "additionalProperties": false,
          "properties": {
            "pr_tier": {"const": "fastlane"},
            "attested": {"const": true},
            "basis": {"type": "string", "minLength": 1}
          }
        },
        "review_completed_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "merge_state": {"const": "CLEAN"},
    "gate_started_at": {"type": "string", "minLength": 1},
    "human_authorization": {
      "$ref": "pr_review_authorizations.schema.json#/properties/human_authorization"
    },
    "run_authorization": {
      "$ref": "pr_review_authorizations.schema.json#/properties/run_authorization"
    }
  }
}

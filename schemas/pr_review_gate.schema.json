{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specrail.local/schemas/pr_review_gate.schema.json",
  "title": "SpecRail compact PR gate evidence v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "repository",
    "pr",
    "linked_issue",
    "state",
    "is_draft",
    "base_sha",
    "head_sha",
    "gate_query_head_sha",
    "changed_files",
    "changed_files_count",
    "changed_files_sha256",
    "checks",
    "merge_state",
    "profile",
    "enforcement_sensitive",
    "sensitive_classification",
    "review",
    "gate_invocation_id"
  ],
  "properties": {
    "contract_version": {"const": 3},
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "pr": {"type": "integer", "minimum": 1},
    "linked_issue": {"type": "integer", "minimum": 1},
    "state": {"const": "OPEN"},
    "is_draft": {"const": false},
    "base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "base_ref": {"type": "string", "minLength": 1},
    "default_base_ref": {"type": "string", "minLength": 1},
    "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "gate_query_head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "changed_files": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "changed_files_count": {"type": "integer", "minimum": 0},
    "changed_files_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "conclusion", "head_sha"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"const": "COMPLETED"},
          "conclusion": {"enum": ["SUCCESS", "NEUTRAL", "SKIPPED"]},
          "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
          "url": {"type": "string", "minLength": 1}
        }
      }
    },
    "checks_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "base_ref",
        "default_base_ref",
        "workflow_trigger_evidence",
        "local_verification",
        "verified"
      ],
      "properties": {
        "reason": {"const": "hosted_ci_not_triggered_for_base"},
        "base_ref": {"type": "string", "minLength": 1},
        "default_base_ref": {"type": "string", "minLength": 1},
        "workflow_trigger_evidence": {"type": "string", "minLength": 1},
        "local_verification": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "verified": {"const": true}
      }
    },
    "merge_state": {"const": "CLEAN"},
    "profile": {"enum": ["fastlane", "standard", "heavy"]},
    "enforcement_sensitive": {"type": "boolean"},
    "sensitive_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "changed_paths",
        "spec_refs",
        "matched_paths",
        "matched_specs",
        "registry_configured",
        "enforcement_sensitive"
      ],
      "properties": {
        "source": {"enum": ["github_changed_files", "tech_spec"]},
        "changed_paths": {"type": "array", "items": {"type": "string"}},
        "spec_refs": {"type": "array", "items": {"type": "string"}},
        "matched_paths": {"type": "array", "items": {"type": "string"}},
        "matched_specs": {"type": "array", "items": {"type": "string"}},
        "registry_configured": {"type": "boolean"},
        "enforcement_sensitive": {"type": "boolean"}
      }
    },
    "review": {"$ref": "review_result.schema.json"},
    "gate_invocation_id": {"type": "string", "minLength": 1},
    "human_merge_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "authorized_at", "head_sha", "invocation_id"],
      "properties": {
        "actor": {"type": "string", "minLength": 1},
        "authorized_at": {"type": "string", "minLength": 1},
        "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "invocation_id": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"checks": {"minItems": 1}},
        "required": ["checks"]
      },
      "then": {
        "properties": {"checks_unavailable": {"type": "null"}}
      }
    },
    {
      "if": {"required": ["checks_unavailable"]},
      "then": {"required": ["base_ref", "default_base_ref"]}
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specrail.local/schemas/review_result.schema.json",
  "title": "SpecRail compact review result v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "base_head_sha",
    "contract_version",
    "diff_sha256",
    "repository",
    "pr",
    "profile",
    "head_sha",
    "review_source",
    "round",
    "mode",
    "verdict",
    "body",
    "findings"
  ],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "contract_version": {"const": 3},
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "pr": {"type": "integer", "minimum": 1},
    "profile": {"enum": ["fastlane", "standard", "heavy"]},
    "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "review_source": {"enum": ["independent_lane", "self_review"]},
    "round": {"type": "integer", "minimum": 1},
    "mode": {"enum": ["full", "diff_only"]},
    "base_head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "diff_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "prior_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "base_head_sha",
        "contract_version",
        "diff_sha256",
        "repository",
        "pr",
        "profile",
        "head_sha",
        "review_source",
        "round",
        "mode",
        "verdict",
        "body",
        "findings"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "base_head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "contract_version": {"const": 3},
        "diff_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "pr": {"type": "integer", "minimum": 1},
        "profile": {"enum": ["fastlane", "standard", "heavy"]},
        "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "review_source": {"enum": ["independent_lane", "self_review"]},
        "round": {"const": 1},
        "mode": {"const": "full"},
        "verdict": {"enum": ["clean", "blocking", "non_blocking"]},
        "body": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "severity", "status", "summary"],
            "properties": {
              "id": {
                "type": "string", "minLength": 1, "pattern": ".*\\S.*"
              },
              "severity": {"enum": ["P0", "P1", "P2", "P3"]},
              "status": {"enum": ["unresolved", "resolved"]},
              "summary": {
                "type": "string", "minLength": 1, "pattern": ".*\\S.*"
              },
              "fix_paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string", "minLength": 1, "pattern": ".*\\S.*"
                }
              },
              "origin": {"enum": ["local", "hosted"]},
              "outdated": {"type": "boolean"},
              "path": {
                "type": "string", "minLength": 1, "pattern": ".*\\S.*"
              },
              "line": {"type": "integer", "minimum": 1},
              "introduced_by_diff": {"type": "boolean"}
            }
          }
        }
      }
    },
    "verdict": {"enum": ["clean", "blocking", "non_blocking"]},
    "body": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "status", "summary"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
          "severity": {"enum": ["P0", "P1", "P2", "P3"]},
          "status": {"enum": ["unresolved", "resolved"]},
          "summary": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
          "fix_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string", "minLength": 1, "pattern": ".*\\S.*"
            }
          },
          "origin": {"enum": ["local", "hosted"]},
          "outdated": {"type": "boolean"},
          "path": {
            "type": "string", "minLength": 1, "pattern": ".*\\S.*"
          },
          "line": {"type": "integer", "minimum": 1},
          "introduced_by_diff": {"type": "boolean"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"round": {"const": 1}}, "required": ["round"]},
      "then": {"properties": {"mode": {"const": "full"}}}
    },
    {
      "if": {"properties": {"round": {"const": 2}}, "required": ["round"]},
      "then": {
        "required": ["base_head_sha", "diff_sha256", "prior_review"],
        "properties": {"mode": {"const": "diff_only"}}
      }
    }
  ]
}
